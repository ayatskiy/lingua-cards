{
  "schema_version": 3,
  "repository": "ayatskiy/lingua-cards",
  "purpose": "Standalone, project-agnostic canonical German flashcard catalog for Deutsch Lesson Cards.",
  "default_branch": "master",
  "write_mode": "pull_request_only",
  "merge_policy": "human_only_never_auto_merge",
  "pr_contract": {
    "commits_exactly": 1,
    "must_be_rebased_on_current_master": true,
    "direct_master_push": false
  },
  "privacy": {
    "preferred_visibility": "private",
    "public_content_requires_explicit_user_authorization": true
  },
  "identity": {
    "algorithm": "sha256(canonical_key)",
    "card_id": "CARD-<64 lowercase hex>",
    "path": "cards/by-key/<first-two-hash-chars>/<card_id>.json",
    "global_index": false
  },
  "bootstrap": "START_HERE.md",
  "rules": "AGENTS.md",
  "workflow": "docs/CARD_WORKFLOW.md",
  "plugin_source": {
    "repository": "ayatskiy/ai-plugins",
    "path": "plugins/deutsch-lesson-cards",
    "plugin_id": "plugins_6abaa53ddf44819198c3e2f47d84f6e6"
  },
  "source_of_truth": {
    "records": "cards/by-key/*/CARD-*.json",
    "project_sets": "projects/<project-slug>/sets/<set-name>.json",
    "card_schema": "schemas/card.schema.json",
    "set_schema": "schemas/card-set.schema.json",
    "srs_schedule": "external: Anki/AnkiDroid"
  },
  "non_goals": [
    "verb inventory persistence",
    "grammar document persistence",
    "review scheduling/progress storage",
    "lesson/source provenance storage"
  ],
  "validation_command": "python scripts/validate_repo.py"
}
