{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ayatskiy/lingua-cards/schemas/card.schema.json",
  "title": "Lingua card record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "card_id",
    "created_date",
    "canonical_key",
    "lemma_de",
    "translation_ru",
    "part_of_speech",
    "cue",
    "target_de",
    "first_seen_lesson",
    "last_seen_lesson",
    "first_seen_date",
    "last_seen_date",
    "seen_in_lessons",
    "source_refs",
    "anki_guid",
    "export_status"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "card_id": {
      "type": "string",
      "pattern": "^CARD-[0-9]{6}$"
    },
    "created_date": {
      "type": "string",
      "format": "date"
    },
    "canonical_key": {
      "type": "string",
      "minLength": 3
    },
    "lemma_de": {
      "type": "string",
      "minLength": 1
    },
    "translation_ru": {
      "type": "string",
      "minLength": 1
    },
    "part_of_speech": {
      "type": "string",
      "minLength": 1
    },
    "article": {
      "type": [
        "string",
        "null"
      ]
    },
    "plural": {
      "type": [
        "string",
        "null"
      ]
    },
    "verb_forms": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "praesens_3sg": {
          "type": [
            "string",
            "null"
          ]
        },
        "praeteritum": {
          "type": [
            "string",
            "null"
          ]
        },
        "partizip_ii": {
          "type": [
            "string",
            "null"
          ]
        },
        "perfekt_auxiliary": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "haben",
            "sein",
            null
          ]
        },
        "perfekt": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "government": {
      "type": [
        "string",
        "null"
      ]
    },
    "grammar_note": {
      "type": [
        "string",
        "null"
      ]
    },
    "cue": {
      "type": "string",
      "minLength": 1
    },
    "target_de": {
      "type": "string",
      "minLength": 1
    },
    "example_de": {
      "type": [
        "string",
        "null"
      ]
    },
    "example_ru": {
      "type": [
        "string",
        "null"
      ]
    },
    "first_seen_lesson": {
      "type": "string",
      "minLength": 1
    },
    "last_seen_lesson": {
      "type": "string",
      "minLength": 1
    },
    "first_seen_date": {
      "type": "string",
      "format": "date"
    },
    "last_seen_date": {
      "type": "string",
      "format": "date"
    },
    "seen_in_lessons": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_type",
          "source_id"
        ],
        "properties": {
          "source_type": {
            "type": "string",
            "minLength": 1
          },
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "anki_guid": {
      "type": "string",
      "minLength": 1
    },
    "export_status": {
      "enum": [
        "NEW",
        "APPROVED",
        "EXPORTED",
        "REJECTED"
      ]
    },
    "export_batch": {
      "type": [
        "string",
        "null"
      ]
    },
    "anki_note_id": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
