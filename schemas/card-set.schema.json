{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ayatskiy/lingua-cards/schemas/card-set.schema.json",
  "title": "Project flashcard set manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "cards"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 2
    },
    "cards": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^CARD-[0-9a-f]{64}$"
      }
    }
  }
}
